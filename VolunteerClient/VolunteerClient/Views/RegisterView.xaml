<UserControl x:Class="VolunteerClient.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Height="730">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="📝 Регистрация" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"
                       Foreground="#2C3E50"/>

            <!-- Имя -->
            <TextBlock Grid.Row="1" Text="Имя" FontWeight="SemiBold" Margin="0,5" Foreground="#555"/>
            <TextBox x:Name="FirstNameBox" 
                     Grid.Row="2" 
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Фамилия -->
            <TextBlock Grid.Row="3" Text="Фамилия" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox x:Name="LastNameBox" 
                     Grid.Row="4" 
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Email -->
            <TextBlock Grid.Row="5" Text="Email" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox x:Name="EmailBox" 
                     Grid.Row="6" 
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Телефон -->
            <TextBlock Grid.Row="7" Text="Телефон" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox x:Name="PhoneBox" 
                     Grid.Row="8" 
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Пароль -->
            <TextBlock Grid.Row="9" Text="Пароль" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <PasswordBox x:Name="PasswordBox" 
                         Grid.Row="10" 
                         Margin="0,5" 
                         Padding="12" 
                         FontSize="14"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Background="#F8F9FA"/>

            <!-- Роль -->
            <TextBlock Grid.Row="11" Text="Роль" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,5">
                <RadioButton x:Name="VolunteerRole" 
                             Content="Волонтёр" 
                             IsChecked="True" 
                             Margin="0,0,20,0"
                             Foreground="#2C3E50"/>
                <RadioButton x:Name="CoordinatorRole" 
                             Content="Координатор"
                             Foreground="#2C3E50"/>
            </StackPanel>

            <!-- Кнопки -->
            <Button x:Name="RegisterButton" 
                    Grid.Row="13" 
                    Content="Зарегистрироваться" 
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="16" 
                    FontWeight="Bold"
                    Padding="12" 
                    Margin="0,20,0,10"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button x:Name="GoToLoginButton" 
                    Grid.Row="13" 
                    Content="Уже есть аккаунт? Войти"
                    Background="Transparent" 
                    Foreground="#3498DB"
                    BorderThickness="0" 
                    Margin="0,65,0,-56"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="#3498DB"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2980B9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </ScrollViewer>
</UserControl>