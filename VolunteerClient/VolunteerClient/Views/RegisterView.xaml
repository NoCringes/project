<UserControl x:Class="VolunteerClient.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📝 Регистрация" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"
                       Foreground="#2C3E50"/>

            <!-- Имя -->
            <TextBlock Grid.Row="1" Text="Имя" FontWeight="SemiBold" Margin="0,5" Foreground="#555"/>
            <TextBox Grid.Row="2" 
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Фамилия -->
            <TextBlock Grid.Row="3" Text="Фамилия" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="4" 
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Email -->
            <TextBlock Grid.Row="5" Text="Email" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="6" 
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Телефон -->
            <TextBlock Grid.Row="7" Text="Телефон" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="8" 
                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Background="#F8F9FA"/>

            <!-- Пароль -->
            <TextBlock Grid.Row="9" Text="Пароль" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <PasswordBox Grid.Row="10" 
                         x:Name="PasswordBox"
                         Margin="0,5" 
                         Padding="12" 
                         FontSize="14"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Background="#F8F9FA"/>

            <!-- Подтверждение пароля -->
            <TextBlock Grid.Row="11" Text="Подтверждение пароля" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <PasswordBox Grid.Row="12" 
                         x:Name="ConfirmPasswordBox"
                         Margin="0,5" 
                         Padding="12" 
                         FontSize="14"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Background="#F8F9FA"/>

            <!-- Роль -->
            <TextBlock Grid.Row="13" Text="Роль" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <StackPanel Grid.Row="14" Orientation="Horizontal" Margin="0,5">
                <RadioButton Content="Волонтёр" 
                             IsChecked="{Binding IsVolunteer}"
                             GroupName="Role"
                             Margin="0,0,20,0"
                             Foreground="#2C3E50"
                             Cursor="Hand"/>
                <RadioButton Content="Координатор" 
                             IsChecked="{Binding IsCoordinator}"
                             GroupName="Role"
                             Foreground="#2C3E50"
                             Cursor="Hand"/>
            </StackPanel>

            <!-- Сообщение об ошибке -->
            <TextBlock Grid.Row="15" 
                       Text="{Binding ErrorMessage}" 
                       Foreground="#E74C3C" 
                       Margin="0,10" 
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>

            <!-- Кнопка регистрации -->
            <Button Grid.Row="16" 
                    Content="Зарегистрироваться" 
                    Command="{Binding RegisterCommand}"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="16" 
                    FontWeight="Bold"
                    Padding="12" 
                    Margin="0,20,0,10"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Content" Value="Регистрация..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Кнопка перехода на вход -->
            <Button Grid.Row="17" 
                    Content="Уже есть аккаунт? Войти"
                    Command="{Binding GoToLoginCommand}"
                    Background="Transparent" 
                    Foreground="#3498DB"
                    BorderThickness="0" 
                    Margin="0,10"
                    Cursor="Hand"/>
        </Grid>
    </ScrollViewer>
</UserControl>