<UserControl x:Class="VolunteerClient.Views.CoordinatorDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Создать мероприятие" 
                        Command="{Binding CreateEventCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#27AE60" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="🔄 Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="🚪 Выйти" 
                        Command="{Binding LogoutCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Список мероприятий -->
        <Border Grid.Row="1" Margin="10" Background="White" CornerRadius="10" 
                BorderBrush="#BDC3C7" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📋 Мои мероприятия" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Padding="15" 
                           Background="#2C3E50" 
                           Foreground="White"/>

                <ListBox ItemsSource="{Binding MyEvents}" 
                         SelectedItem="{Binding SelectedEvent}"
                         Height="500" 
                         Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Location}" Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="Gray" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="Начало: "/>
                                            <Run Text="{Binding StartDateTime, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="Gray" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="Окончание: "/>
                                            <Run Text="{Binding EndDateTime, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="Gray" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="Макс. волонтёров: "/>
                                            <Run Text="{Binding MaxVolunteers}"/>
                                        </TextBlock>

                                        <!-- Статус -->
                                        <TextBlock FontSize="12" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                    <Setter Property="Text" Value="✅ Активно"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="completed">
                                                            <Setter Property="Foreground" Value="#3498DB"/>
                                                            <Setter Property="Text" Value="📌 Завершено"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                            <Setter Property="Text" Value="❌ Отменено"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="👥 Волонтёры" 
                                                Command="{Binding DataContext.ViewRegistrationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="5" 
                                                Padding="8,5" 
                                                Background="#3498DB" 
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                        <Button Content="✏️ Редактировать" 
                                                Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="5" 
                                                Padding="8,5" 
                                                Background="#F39C12" 
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                        <Button Content="🗑️ Удалить" 
                                                Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="5" 
                                                Padding="8,5" 
                                                Background="#E74C3C" 
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>