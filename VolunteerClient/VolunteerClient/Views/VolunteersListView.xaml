<UserControl x:Class="VolunteerClient.Views.VolunteersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация о мероприятии -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="{Binding EventTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding EventLocation}" Foreground="LightGray" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding EventStartDateTime, StringFormat='Начало: dd.MM.yyyy HH:mm'}" Foreground="LightGray"/>
            </StackPanel>
        </Border>

        <!-- Верхняя панель -->
        <Border Grid.Row="1" Background="#ECF0F1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="← Назад" 
                        Command="{Binding BackCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#95A5A6" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Список слотов с волонтёрами -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" 
                                    BorderBrush="#BDC3C7" BorderThickness="1" 
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Заголовок слота -->
                                    <Border Background="#2C3E50" CornerRadius="10,10,0,0" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="{Binding Description}" Foreground="LightGray" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Foreground="LightGray" FontSize="12">
                                                <Run Text="Мест: "/>
                                                <Run Text="{Binding CurrentRegistrations}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding SlotsAvailable}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Список волонтёров -->
                                    <ItemsControl ItemsSource="{Binding Volunteers}" Margin="10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock FontWeight="Bold">
                                                                <Run Text="{Binding VolunteerName}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding VolunteerEmail}" Foreground="Gray" FontSize="12"/>
                                                            <TextBlock Text="{Binding VolunteerPhone}" Foreground="Gray" FontSize="12"/>
                                                            <TextBlock Foreground="Gray" FontSize="12">
                                                                <Run Text="Записался: "/>
                                                                <Run Text="{Binding RegisteredAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                                            </TextBlock>

                                                            <!-- Статус -->
                                                            <TextBlock FontSize="12" Margin="0,5,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#3498DB"/>
                                                                        <Setter Property="Text" Value="✅ Записан"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="attended">
                                                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                                                <Setter Property="Text" Value="🏆 Отметился"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                                                <Setter Property="Text" Value="❌ Отменён"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Кнопка подтверждения -->
                                                        <Button Grid.Column="1" 
                                                                Content="✅ Подтвердить"
                                                                Command="{Binding DataContext.ConfirmAttendanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#27AE60"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Padding="10,5"
                                                                Margin="10,0,0,0"
                                                                Visibility="{Binding Status, Converter={StaticResource StatusToAttendanceVisibility}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Если нет волонтёров -->
                                    <TextBlock Text="Нет записавшихся волонтёров" 
                                               Foreground="Gray" 
                                               HorizontalAlignment="Center" 
                                               Margin="10"
                                               Visibility="{Binding Volunteers, Converter={StaticResource EmptyListToVisible}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Ошибка -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#E74C3C" Margin="10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
    </Grid>
</UserControl>