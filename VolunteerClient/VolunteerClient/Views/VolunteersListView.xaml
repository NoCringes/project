<UserControl x:Class="VolunteerClient.Views.VolunteersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8" Height="881">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация о мероприятии -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="{Binding EventTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding EventLocation}" Foreground="LightGray" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding EventStartDateTime, StringFormat='Начало: dd.MM.yyyy HH:mm'}" Foreground="LightGray"/>
            </StackPanel>
        </Border>

        <!-- Верхняя панель -->
        <Border Grid.Row="1" Background="#ECF0F1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="← Назад" 
                        Command="{Binding BackCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#95A5A6" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Список волонтёров -->
        <Border Grid.Row="2" Margin="10" Background="White" CornerRadius="10" 
                BorderBrush="#BDC3C7" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="👥 Записавшиеся волонтёры" 
                           FontSize="18" FontWeight="Bold" 
                           Padding="15" Background="#2C3E50" Foreground="White"/>

                <ListBox ItemsSource="{Binding Volunteers}" Margin="10" Height="599">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" FontSize="14">
                                            <Run Text="{Binding VolunteerName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding VolunteerEmail}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding VolunteerPhone}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Foreground="Gray" FontSize="12">
                                            <Run Text="Слот: "/>
                                            <Run Text="{Binding SlotTitle}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="Gray" FontSize="12">
                                            <Run Text="Записался: "/>
                                            <Run Text="{Binding RegisteredAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        </TextBlock>

                                        <!-- Статус -->
                                        <TextBlock FontSize="12" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#3498DB"/>
                                                    <Setter Property="Text" Value="✅ Записан"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="attended">
                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                            <Setter Property="Text" Value="🏆 Отметился"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                            <Setter Property="Text" Value="❌ Отменён"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Кнопка подтверждения участия (только для записанных) -->
                                    <Button Grid.Column="1" 
                                            Content="✅ Подтвердить"
                                            Command="{Binding DataContext.ConfirmAttendanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#27AE60"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="10,5"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding Status, Converter={StaticResource StatusToAttendanceVisibility}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Ошибка -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#E74C3C" Margin="10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
    </Grid>
</UserControl>