<UserControl x:Class="VolunteerClient.Views.CreateEventView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="➕ Создание мероприятия" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"
                       Foreground="#2C3E50"/>

            <!-- Название -->
            <TextBlock Grid.Row="1" Text="Название мероприятия" FontWeight="SemiBold" Margin="0,5" Foreground="#555"/>
            <TextBox Grid.Row="2" 
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Tag="Например: Весенняя уборка парка"/>

            <!-- Описание -->
            <TextBlock Grid.Row="3" Text="Описание мероприятия" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="4" 
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Tag="Подробное описание мероприятия и что потребуется делать"/>

            <!-- Место проведения -->
            <TextBlock Grid.Row="5" Text="Место проведения" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="6" 
                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Tag="Адрес или место проведения"/>

            <!-- Дата и время -->
            <Grid Grid.Row="7" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Дата начала" FontWeight="SemiBold" Margin="0,5" Foreground="#555"/>
                    <DatePicker SelectedDate="{Binding StartDateTime}" Margin="0,5" />
                    <TextBox Text="{Binding StartDateTime, StringFormat='HH:mm'}" 
                             Margin="0,5" Padding="10" Tag="Время начала (ЧЧ:ММ)"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Дата окончания" FontWeight="SemiBold" Margin="0,5" Foreground="#555"/>
                    <DatePicker SelectedDate="{Binding EndDateTime}" Margin="0,5" />
                    <TextBox Text="{Binding EndDateTime, StringFormat='HH:mm'}" 
                             Margin="0,5" Padding="10" Tag="Время окончания (ЧЧ:ММ)"/>
                </StackPanel>
            </Grid>

            <!-- Макс. волонтёров -->
            <TextBlock Grid.Row="8" Text="Максимальное количество волонтёров" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
            <TextBox Grid.Row="9" 
                     Text="{Binding MaxVolunteers, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5" 
                     Padding="12" 
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     Tag="Общее количество волонтёров на мероприятие"/>

            <!-- Слоты -->
            <Border Grid.Row="10" CornerRadius="8" Background="#ECF0F1" Padding="10" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="📌 Слоты (роли)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Слоты — это конкретные роли или задачи на мероприятии (например: 'Раздача воды', 'Встреча гостей', 'Уборка территории')." 
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="5" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Название слота" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" 
                                                     Padding="8" 
                                                     Tag="Например: Раздача воды"
                                                     BorderBrush="#BDC3C7"
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Описание слота" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" 
                                                     Padding="8" 
                                                     Tag="Что нужно будет делать"
                                                     BorderBrush="#BDC3C7"
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Количество мест" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SlotsAvailable, UpdateSourceTrigger=LostFocus, TargetNullValue=1, FallbackValue=1}"
                                                     Margin="0,0,0,5" 
                                                     Padding="8" 
                                                     Tag="Сколько волонтёров нужно"
                                                     BorderBrush="#BDC3C7"
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" 
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Content="❌"
                                                Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Width="35"
                                                Height="35"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Удалить этот слот"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="➕ Добавить слот"
                            Command="{Binding AddSlotCommand}"
                            Background="#3498DB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="10,5"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ошибка -->
            <TextBlock Grid.Row="11" 
                       Text="{Binding ErrorMessage}" 
                       Foreground="#E74C3C" 
                       Margin="0,10" 
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,15">
                <Button Content="💾 Сохранить" 
                        Command="{Binding SaveCommand}"
                        Width="120"
                        Margin="5" 
                        Padding="10" 
                        Background="#27AE60" 
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="Сохранение..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="❌ Отмена" 
                        Command="{Binding CancelCommand}"
                        Width="120"
                        Margin="5" 
                        Padding="10" 
                        Background="#95A5A6" 
                        Foreground="White"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>