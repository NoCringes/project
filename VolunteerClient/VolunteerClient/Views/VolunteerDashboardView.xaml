<UserControl x:Class="VolunteerClient.Views.VolunteerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <Border Background="#ECF0F1" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" 
                        Content="🔄 Обновить" 
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        Cursor="Hand"/>
                <Button x:Name="LogoutButton" 
                        Content="🚪 Выйти" 
                        Margin="5" 
                        Padding="10,5" 
                        Background="#E74C3C" 
                        Foreground="White"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список мероприятий (левая колонка) -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="10" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="📅 Доступные мероприятия" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Padding="10" 
                               Background="#3498DB" 
                               Foreground="White"/>

                    <TextBox x:Name="SearchBox" 
                             Margin="10" 
                             Padding="8" 
                             Tag="Поиск по названию..."/>

                    <ListBox x:Name="EventsList" Height="400" Margin="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Уборка парка" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="г. Москва, Центральный парк" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="15.06.2026 10:00" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="📋 20 мест" Foreground="Gray" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Мои записи (правая колонка) -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="10" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="⭐ Мои мероприятия" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Padding="10" 
                               Background="#2ECC71" 
                               Foreground="White"/>

                    <ListBox x:Name="MyRegistrationsList" Height="400" Margin="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Уборка парка" FontWeight="Bold"/>
                                        <TextBlock Text="Сбор мусора" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="Статус: ✅ Записан" FontSize="12" Foreground="#27AE60"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>