<UserControl x:Class="VolunteerClient.Views.VolunteerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="🚪 Выйти" 
                        Command="{Binding LogoutCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Список мероприятий -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" 
                    BorderBrush="#BDC3C7" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="📅 Доступные мероприятия" 
                               FontSize="18" FontWeight="Bold" 
                               Padding="10" Background="#3498DB" Foreground="White"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="10" 
                             Padding="8" 
                             Tag="Поиск по названию..."
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"/>

                    <ListBox ItemsSource="{Binding Events}" 
                             SelectedItem="{Binding SelectedEvent}"
                             Margin="10" 
                             Height="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenEventDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Location}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding StartDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding MaxVolunteers, StringFormat='Макс. волонтёров: {0}'}" Foreground="Gray" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Правая колонка: Мои записи -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" 
                    BorderBrush="#BDC3C7" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="⭐ Мои мероприятия" 
                               FontSize="18" FontWeight="Bold" 
                               Padding="10" Background="#2ECC71" Foreground="White"/>

                    <ListBox ItemsSource="{Binding MyApplications}" Margin="10" Height="454">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenEventFromMyApplicationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding EventTitle}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SlotTitle}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding EventStartDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="Gray" FontSize="12"/>

                                        <!-- Статус -->
                                        <TextBlock FontSize="12" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#3498DB"/>
                                                    <Setter Property="Text" Value="✅ Записан"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="attended">
                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                            <Setter Property="Text" Value="🏆 Отметился"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                            <Setter Property="Text" Value="❌ Отменён"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Кнопки -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Отменить" 
                                                    Command="{Binding DataContext.CancelApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding RecordId}"
                                                    Width="100"
                                                    Background="#E74C3C"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0"
                                                    Visibility="{Binding Status, Converter={StaticResource StatusToVisibility}}"/>

                                            <Button Content="🏆 Отметиться" 
                                                    Command="{Binding DataContext.MarkAttendanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding RecordId}"
                                                    Width="100"
                                                    Background="#27AE60"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="8,3"
                                                    Visibility="{Binding Status, Converter={StaticResource StatusToAttendanceVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>