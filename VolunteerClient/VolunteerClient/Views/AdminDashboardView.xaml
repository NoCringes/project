<UserControl x:Class="VolunteerClient.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" 
                        Content="🔄 Обновить" 
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button x:Name="LogoutButton" 
                        Content="🚪 Выйти" 
                        Margin="5" 
                        Padding="10,5" 
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Вкладка 1: Пользователи -->
            <TabItem Header="👥 Пользователи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Карточки статистики -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#3498DB" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="👥" FontSize="30"/>
                                <TextBlock x:Name="TotalUsersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Всего пользователей" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#27AE60" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="🤝" FontSize="30"/>
                                <TextBlock x:Name="TotalVolunteersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Волонтёров" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F39C12" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="30"/>
                                <TextBlock x:Name="TotalCoordinatorsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Координаторов" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#9B59B6" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📅" FontSize="30"/>
                                <TextBlock x:Name="TotalEventsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Мероприятий" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Список пользователей -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" 
                            BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👥 Управление пользователями" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Padding="15" 
                                       Background="#2C3E50" 
                                       Foreground="White"/>

                            <ListBox x:Name="UsersList" Height="350" Margin="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="Bold">
                                                        <Run Text="{Binding FirstName}"/>
                                                        <Run Text="{Binding LastName}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Email}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding Phone}" Foreground="Gray" FontSize="12"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" 
                                                        Background="{Binding RoleColor}" 
                                                        CornerRadius="5" 
                                                        Padding="5" 
                                                        Height="25"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" 
                                                               Foreground="White" 
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Кнопка редактирования -->
                                                    <Button x:Name="EditUserButton" 
                                                            Content="✏️" 
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#3498DB" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            ToolTip="Редактировать пользователя"/>
                                                    <!-- Кнопка смены роли -->
                                                    <Button x:Name="ChangeRoleButton" 
                                                            Content="🔄" 
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#F39C12" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            ToolTip="Сменить роль"/>
                                                    <!-- Кнопка удаления -->
                                                    <Button x:Name="DeleteUserButton" 
                                                            Content="🗑️" 
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#E74C3C" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            ToolTip="Удалить пользователя"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Мероприятия -->
            <TabItem Header="📅 Мероприятия">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопка создания мероприятия -->
                    <Border Grid.Row="0" Background="#ECF0F1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <Button x:Name="CreateEventButton" 
                                Content="➕ Создать мероприятие" 
                                HorizontalAlignment="Left"
                                Padding="15,10" 
                                Background="#27AE60" 
                                Foreground="White"
                                FontSize="14"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Border>

                    <!-- Список мероприятий -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" 
                            BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📋 Все мероприятия" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Padding="15" 
                                       Background="#2C3E50" 
                                       Foreground="White"/>

                            <ListBox x:Name="EventsList" Height="450" Margin="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Location}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding Date}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding Coordinator}" Foreground="Gray" FontSize="12"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="EditEventButton" 
                                                            Content="✏️ Редактировать" 
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#F39C12" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"/>
                                                    <Button x:Name="DeleteEventButton" 
                                                            Content="🗑️ Удалить" 
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#E74C3C" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"/>
                                                    <Button x:Name="ViewVolunteersButton" 
                                                            Content="👥 Волонтёры" 
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#3498DB" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>