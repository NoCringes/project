<UserControl x:Class="VolunteerClient.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="🚪 Выйти" 
                        Command="{Binding LogoutCommand}"
                        Margin="5" 
                        Padding="10,5" 
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Карточки статистики -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#3498DB" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="👥" FontSize="30"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Всего пользователей" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#27AE60" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🤝" FontSize="30"/>
                        <TextBlock Text="{Binding TotalVolunteers}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Волонтёров" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F39C12" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="30"/>
                        <TextBlock Text="{Binding TotalCoordinators}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Координаторов" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#9B59B6" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="30"/>
                        <TextBlock Text="{Binding TotalEvents}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Мероприятий" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Вкладки -->
            <TabControl Grid.Row="1">
                <!-- Вкладка: Пользователи -->
                <TabItem Header="👥 Пользователи">
                    <Border Background="White" CornerRadius="10" 
                            BorderBrush="#BDC3C7" BorderThickness="1"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Управление пользователями" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Padding="15" 
                                       Background="#2C3E50" 
                                       Foreground="White"/>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="10" 
                                     Padding="8" 
                                     Tag="Поиск по email, имени, фамилии..."
                                     BorderBrush="#BDC3C7"
                                     BorderThickness="1"/>

                            <ListBox ItemsSource="{Binding Users}" 
                                     SelectedItem="{Binding SelectedUser}"
                                     Height="350" 
                                     Margin="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="Bold">
                                                        <Run Text="{Binding FirstName}"/>
                                                        <Run Text="{Binding LastName}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Email}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding Phone}" Foreground="Gray" FontSize="12"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" 
                                                        CornerRadius="5" 
                                                        Padding="5" 
                                                        Height="25"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#95A5A6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                    <Setter Property="Background" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="coordinator">
                                                                    <Setter Property="Background" Value="#F39C12"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="volunteer">
                                                                    <Setter Property="Background" Value="#27AE60"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Role}" 
                                                               Foreground="White" 
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="✏️" 
                                                            Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#3498DB" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Редактировать"/>
                                                    <Button Content="🔄" 
                                                            Command="{Binding DataContext.ChangeRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#F39C12" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Сменить роль"/>
                                                    <Button Content="🗑️" 
                                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="3" 
                                                            Padding="8,5" 
                                                            Background="#E74C3C" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Удалить"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Вкладка: Мероприятия -->
                <TabItem Header="📅 Мероприятия">
                    <Border Background="White" CornerRadius="10" 
                            BorderBrush="#BDC3C7" BorderThickness="1"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Управление мероприятиями" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Padding="15" 
                                       Background="#2C3E50" 
                                       Foreground="White"/>

                            <ListBox ItemsSource="{Binding AllEvents}" 
                                     SelectedItem="{Binding SelectedEvent}"
                                     Height="450" 
                                     Margin="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Margin="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Location}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding StartDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Foreground="Gray" FontSize="12">
                                                        <Run Text="Создатель: "/>
                                                        <Run Text="{Binding CreatorName}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="👥 Волонтёры" 
                                                            Command="{Binding DataContext.ViewVolunteersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#3498DB" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                    <Button Content="✏️ Редактировать" 
                                                            Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#F39C12" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                    <Button Content="🗑️ Удалить" 
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="5" 
                                                            Padding="8,5" 
                                                            Background="#E74C3C" 
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>